      ],
      "metadata": {
        "id": "eWSBgs7yrRzZ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "cnn = Sequential()\n",
        "\n",
        "cnn.add(\n",
        "    Conv1D(\n",
        "        64,\n",
        "        5,\n",
        "        activation=\"relu\",\n",
        "        input_shape=(\n",
        "            WINDOW,\n",
        "            len(FEATURES)\n",
        "        )\n",
        "    )\n",
        ")\n",
        "\n",
        "cnn.add(MaxPooling1D())\n",
        "\n",
        "cnn.add(\n",
        "    Conv1D(\n",
        "        128,\n",
        "        3,\n",
        "        activation=\"relu\"\n",
        "    )\n",
        ")\n",
        "\n",
        "cnn.add(MaxPooling1D())\n",
        "\n",
        "cnn.add(Flatten())\n",
        "\n",
        "cnn.add(Dense(\n",
        "    256,\n",
        "    activation=\"relu\"\n",
        "))\n",
        "\n",
        "cnn.add(\n",
        "    Dropout(0.5)\n",
        ")\n",
        "\n",
        "cnn.add(\n",
        "    Dense(\n",
        "        n_classes,\n",
        "        activation=\"softmax\"\n",
        "    )\n",
        ")\n",
        "\n",
        "cnn.compile(\n",
        "    optimizer=\"adam\",\n",
        "    loss=\"sparse_categorical_crossentropy\",\n",
        "    metrics=[\"accuracy\"]\n",
        ")"
