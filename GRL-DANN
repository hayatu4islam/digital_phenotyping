    {
      "cell_type": "code",
      "source": [
        "from scipy.stats import ks_2samp\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "def compute_ks_shift(source_data, target_data):\n",
        "    # Convert to numpy if they're DataFrames\n",
        "    if isinstance(source_data, pd.DataFrame):\n",
        "        source_data = source_data.values\n",
        "    if isinstance(target_data, pd.DataFrame):\n",
        "        target_data = target_data.values\n",
        "\n",
        "    results = []\n",
        "    n_features = source_data.shape[1]\n",
        "\n",
        "    for feature in range(n_features):\n",
        "        D, p = ks_2samp(\n",
        "            source_data[:, feature],\n",
        "            target_data[:, feature]\n",
        "        )\n",
        "        results.append([feature, D, p])\n",
        "\n",
        "    return pd.DataFrame(\n",
        "        results,\n",
        "        columns=[\"Feature\", \"KS Statistic\", \"p-value\"]\n",
        "    )\n",
        "\n",
        "# Now works with both DataFrames and NumPy arrays\n",
        "ks_results = compute_ks_shift(X_source, X_target)\n",
        "\n",
        "print(ks_results)\n",
        "\n",
        "overall_shift = ks_results[\"KS Statistic\"].mean()\n",
        "\n",
        "print(\"Average KS Shift =\", overall_shift)"
