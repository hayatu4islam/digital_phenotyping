    {
      "cell_type": "code",
      "source": [
        "class GradientReversal(tf.keras.layers.Layer):\n",
        "\n",
        "    def __init__(\n",
        "            self,\n",
        "            hp_lambda=1.0):\n",
        "        super().__init__()\n",
        "        self.hp_lambda = hp_lambda\n",
        "\n",
        "    def call(self, x):\n",
        "\n",
        "        @tf.custom_gradient\n",
        "        def reverse_grad(x):\n",
        "\n",
        "            def grad(dy):\n",
        "                return -self.hp_lambda * dy\n",
        "\n",
        "            return x, grad\n",
        "\n",
        "        return reverse_grad(x)"
      ],
      "metadata": {
        "id": "Nn3_bqDDrmlx"
      },
      "execution_count": null,
      "outputs": []
    },
