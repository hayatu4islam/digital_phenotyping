      "source": [
        "### Window Segmentation - (Deep models require sequences)"
      ],
      "metadata": {
        "id": "6ElzYUtQrF9B"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "WINDOW = 128\n",
        "STEP = 64\n",
        "\n",
        "def create_windows(X, y):\n",
        "\n",
        "    xs = []\n",
        "    ys = []\n",
        "\n",
        "    for start in range(0,len(X)-WINDOW,STEP):\n",
        "\n",
        "        end = start + WINDOW\n",
        "\n",
        "        xs.append(X[start:end])\n",
        "\n",
        "        ys.append(np.bincount(y[start:end]).argmax())\n",
        "\n",
        "    return np.array(xs), np.array(ys)\n",
        "\n",
        "Xw_train, yw_train = create_windows(X_source, y_source)\n",
        "\n",
        "Xp_test, yp_test = create_windows(X_target,y_target)\n",
        "\n"
      ],
      "metadata": {
        "id": "ppabyaXhrMHy"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
