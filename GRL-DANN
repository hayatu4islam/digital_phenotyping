l:.4f}\")\\nprint(f\"Target accuracy (Hand): {acc_hand:.4f}\")\\n\\n# Calculate per-class accuracy on both domains\\ndef per_class_accuracy(model, X_data, y_data):\\n    y_pred = np.argmax(model.predict(X_data), axis=1)\\n    per_class = {}\\n    for i in range(num_classes):\\n        mask = y_data == i\\n        if mask.sum() > 0:\\n            per_class[activities[i]] = accuracy_score(y_data[mask], y_pred[mask])\\n    return per_class\\n\\nsource_per_class = per_class_accuracy(model, X_source_val, y_source_val)\\ntarget_per_class = per_class_accuracy(model, X_hand, y_hand)\\n\\nprint(\"\\nPer-class accuracy comparison:\")\\nprint(\"-\"*60)\\nclass_comparison = pd.DataFrame({\\n    \\'Pocket (Source)\\': source_per_class,\\n    \\'Hand (Target)\\': target_per_class,\\n    \\'Drop (%)\\': [(source_per_class.get(a, 0) - target_per_class.get(a, 0)) * 100\\n                 for a in activities]\\n}, index=activities)\\nprint(class_comparison.round(4))\\n\\n# ============================================================================\\n# 7. VISUALIZATION\\n# ============================================================================\\n\\ndef plot_results(history, acc_source_val, acc_hand, class_comparison):\\n    \"\"\"Visualize training history and results.\"\"\"\\n\\n    fig, axes = plt.subplots(2, 3, figsize=(18, 10))\\n\\n    # 1. Training curves\\n    ax1 = axes[0, 0]\\n    ax1.plot(history.history[\\'loss\\'], label=\\'Train Loss\\', linewidth=2)\\n    ax1.plot(history.history[\\'val_loss\\'], label=\\'Val Loss\\', linewidth=2)\\n    ax1.set_title(\\'Training and Validation Loss\\', fontsize=12)\\n    ax1.set_xlabel(\\'Epoch\\')\\n    ax1.set_ylabel(\\'Loss\\')\\n    ax1.legend()\\n    ax1.grid(True, alpha=0.3)\\n\\n    # 2. Accuracy curves\\n    ax2 = axes[0, 1]\\n    ax2.plot(history.history[\\'accuracy\\'], label=\\'Train Acc\\', linewidth=2)\\n    ax2.plot(history.history[\\'val_accuracy\\'], label=\\'Val Acc\\', linewidth=2)\\n    ax2.set_title(\\'Training 