              "'\\nimport numpy as np\\nimport pandas as pd\\nimport tensorflow as tf\\nfrom tensorflow import keras\\nfrom tensorflow.keras import layers, models\\nfrom sklearn.model_selection import train_test_split\\nfrom sklearn.preprocessing import StandardScaler, LabelEncoder\\nfrom sklearn.metrics import accuracy_score, classification_report, confusion_matrix\\nimport matplotlib.pyplot as plt\\nimport seaborn as sns\\nimport warnings\\nwarnings.filterwarnings(\\'ignore\\')\\n\\n# Set random seeds for reproducibility\\nnp.random.seed(42)\\ntf.random.set_seed(42)\\n\\n# ============================================================================\\n# 1. DATA GENERATION (Simulating Pocket vs Hand placement)\\n# ============================================================================\\n\\ndef generate_sensor_data(num_samples=1000, placement=\\'pocket\\', noise_level=0.1):\\n    \"\"\"\\n    Generate synthetic sensor data mimicking smartphone accelerometer/gyroscope\\n    readings from different placements.\\n\\n    Parameters:\\n    -----------\\n    num_samples : int\\n        Number of samples to generate\\n    placement : str\\n        \\'pocket\\' or \\'hand\\' - affects signal characteristics\\n    noise_level : float\\n        Standard deviation of noise\\n    \"\"\"\\n\\n    # Time series parameters\\n    sequence_length = 128\\n    n_features = 6  # 3-axis accelerometer + 3-axis gyroscope\\n\\n    # Different patterns for each activity (simulating 6 activities)\\n    activities = [\\'walking\\', \\'running\\', \\'sitting\\', \\'standing\\', \\'climbing\\', \\'jumping\\']\\n    n_classes = len(activities)\\n\\n    X = []\\n    y = []\\n\\n    for sample in range(num_samples):\\n        # Randomly select activity\\n        activity_idx = np.random.randint(0, n_classes)\\n        activity = activities[activity_idx]\\n\\n        # Generate base signal with activity-specific patterns\\n        t = np.linspace(0, 4*np.pi, sequence_length)\\n\\n        if activity == \\'walking\\':\\n            freq = 1.0\\n            amp = 0.8\\n        elif activity == \\'running\\':\\n            freq = 2.0\\n            amp = 1.2\\n        elif activity == \\'sitting\\':\\n            freq = 0.2\\n            amp = 0.3\\n        elif activity == \\'standing\\':\\n            freq = 0.1\\n            amp = 0.2\\n        elif activity == \\'climbing\\':\\n            freq = 1.2\\n            amp = 1.0\\n        else:  # jumping\\n            freq = 0.8\\n            amp = 1.5\\n\\n        # Generate multi-channel signal\\n        signal = np.zeros((sequence_length, n_features))\\n\\n        # Add placement-specific transformations\\n        if placement == \\'pocket\\':\\n            # Pocket: more damping, lower amplitude, more noise\\n            amplitude_scale = 0.7 + 0.3 * np.random.random()\\n            phase_shift = 0.5\\n            noise_scale = noise_level * 1.5\\n        else:  # hand\\n            # Hand: more dynamic, higher amplitude, different orientation\\n            amplitude_scale = 0.9 + 0.4 * np.random.random()\\n            phase_shift = 0.0\\n            noise_scale = noise_level * 1.0\\n\\n        for channel in range(n_features):\\n            # Base signal with activity pattern\\n            base = amp * amplitude_scale * np.sin(freq * t + channel * phase_shift + np.random.random() * 0.5)\\n\\n            # Add some harmonics\\n            base += 0.3 * amp * amplitude_scale * np.sin(2 * freq * t + channel * 0.8)\\n            base += 0.1 * amp * amplitude_scale * np.sin(3 * freq * t + channel * 0.3)\\n\\n            # Add placement-specific modulation\\n            if placement == \\'pocket\\':\\n                # Pocket dampens high-frequency components\\n                base = 0.7 * base + 0.3 * np.convolve(base, np.ones(5)/5, mode=\\'same\\')\\n\\n            # Add noise\\n            noise = np.random.normal(0, noise_scale, sequence_length)\\n            signal[:, channel] = base + noise\\n\\n        X.append(signal)\\n        y.append(activity_idx)\\n\\n    return np.array(X), np.array(y), activities\\n\\n# ============================================================================\\n# 2. DATA LOADING AND PREPROCESSING\\n# ============================================================================\\n\\nprint(\"=\"*60)\\nprint(\"LOADING DATA: POCKET (Source) vs HAND (Target)\")\\nprint(\"=\"*60)\\n\\n# Generate data\\nprint(\"\\nGenerating synthetic sensor data...\")\\nX_pocket, y_pocket, activities = generate_sensor_data(\\n    num_samples=2000, placement=\\'pocket\\', noise_level=0.1\\n)\\nX_hand, y_hand, _ = generate_sensor_data(\\n    num_samples=2000, placement=\\'hand\\', noise_level=0.1\\n)\\n\\nprint(f\"Pocket data shape: {X_pocket.shape}\")\\nprint(f\"Hand data shape: {X_hand.shape}\")\\n\\n# Split pocket data into train/val\\nX_source_train, X_source_val, y_source_train, y_source_val = train_test_split(\\n    X_pocket, y_pocket, test_size=0.2, random_state=42, stratify=y_pocket\\n)\\n\\nprint(f\"\\nSource (Pocket) train: {X_source_train.shape[0]} samples\")\\nprint(f\"Source (Pocket) val: {X_source_val.shape[0]} samples\")\\nprint(f\"Target (Hand): {X_hand.shape[0]} samples\")\\n\\n# ============================================================================\\n# 3. CNN MODEL DEFINITION\\n# ============================================================================\\n\\ndef create_cnn_model(input_shape, num_classes, use_dropout=True):\\n    \"\"\"\\n    Create a CNN model for sensor time series classification.\\n\\n    Architecture inspired by:\\n    - DeepConvLSTM for activity recognition\\n    - TCN (Temporal Convolutional Networks)\\n    \"\"\"\\n\\n    model = models.Sequential([\\n        # First convolutional block\\n        layers.Conv1D(filters=64, kernel_size=3, padding=\\'same\\', input_shape=input_shape),\\n        layers.BatchNormalization(),\\n        layers.ReLU(),\\n        layers.MaxPooling1D(pool_size=2),\\n\\n        # Second convolutional block\\n        layers.Conv1D(filters=128, kernel_size=3, padding=\\'same\\'),\\n        layers.BatchNormalization(),\\n        layers.ReLU(),\\n        layers.MaxPooling1D(pool_size=2),\\n\\n        # Third convolutional block\\n        layers.Conv1D(filters=256, kernel_size=3, padding=\\'same\\'),\\n        layers.BatchNormalization(),\\n        layers.ReLU(),\\n        layers.MaxPooling1D(pool_size=2),\\n\\n        # Fourth convolutional block\\n        layers.Conv1D(filters=256, kernel_size=3, padding=\\'same\\'),\\n        layers.BatchNormalization(),\\n        layers.ReLU(),\\n        layers.GlobalAveragePooling1D(),\\n\\n        # Dense layers\\n        layers.Dense(128),\\n        layers.BatchNormalization(),\\n        layers.ReLU(),\\n\\n        # Dropout for regularization\\n        layers.Dropout(0.5 if use_dropout else 0.0),\\n\\n        # Output layer\\n        layers.Dense(num_classes, activation=\\'softmax\\')\\n    ])\\n\\n    return model\\n\\n# ============================================================================\\n# 4. TRAIN ON POCKET (NO ADAPTATION)\\n# ============================================================================\\n\\n# Get input shape\\ninput_shape = (X_source_train.shape[1], X_source_train.shape[2])\\nnum_classes = len(np.unique(y_source_train))\\n\\nprint(f\"\\nInput shape: {input_shape}\")\\nprint(f\"Number of classes: {num_classes}\")\\n\\n# Create and compile model\\nmodel = create_cnn_model(input_shape, num_classes)\\n\\nmodel.compile(\\n    optimizer=keras.optimizers.Adam(learning_rate=1e-3),\\n    loss=\\'sparse_categorical_crossentropy\\',\\n    metrics=[\\'accuracy\\']\\n)\\n\\nprint(\"\\nModel Summary:\")\\nprint(\"-\" * 60)\\nmodel.summary()\\nprint(\"-\" * 60)\\n\\n# Callbacks\\ncallbacks = [\\n    keras.callbacks.EarlyStopping(\\n        patience=20,\\n        restore_best_weights=True,\\n        monitor=\\'val_loss\\'\\n    ),\\n    keras.callbacks.ReduceLROnPlateau(\\n        factor=0.5,\\n        